# ============================================================
# 生产环境配置模板
# 部署时复制为 .env 并填入真实值
# ============================================================

APP_NAME=内部数据分析工具
APP_VERSION=1.0.0
DEBUG=False
API_V1_PREFIX=/api/v1

# 数据库（生产 MySQL 集群）
DATABASE_URL=mysql+aiomysql://app_user:CHANGE_ME@db-master.internal:3306/data_analysis
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis（生产 Redis Sentinel/Cluster）
REDIS_URL=redis://:CHANGE_ME@redis.internal:6379/0
REDIS_MAX_CONNECTIONS=50

# JWT（务必使用强随机密钥：openssl rand -hex 32）
JWT_SECRET_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# 会话安全
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# AES 加密（务必使用强随机密钥：openssl rand -hex 32）
AES_SECRET_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_32_64_CHARS

# LLM（生产限流更严格）
LLM_DEFAULT_MAX_TOKENS=4096
LLM_DEFAULT_TEMPERATURE=0.7
LLM_RATE_LIMIT_PER_HOUR=100
LLM_CONTEXT_MAX_TURNS=20
LLM_CONTEXT_TOKEN_RATIO=0.6
LLM_CONVERSATION_ARCHIVE_HOURS=24

# ReAct（生产超时更短）
REACT_MAX_ITERATIONS=5
REACT_QUALITY_THRESHOLD=0.8
REACT_ENABLE_SELF_CHECK=True
REACT_TIMEOUT_SECONDS=60

# 向量库
VECTOR_DB_TYPE=chromadb
CHROMADB_HOST=chromadb.internal
CHROMADB_PORT=8000
MILVUS_HOST=milvus.internal
MILVUS_PORT=19530

# Embedding
EMBEDDING_MODEL_NAME=shibing624/text2vec-base-chinese
EMBEDDING_DIMENSION=768

# Celery
CELERY_BROKER_URL=redis://:CHANGE_ME@redis.internal:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME@redis.internal:6379/2
